{
  "builder": "RAILPACK",
  "dockerfilePath": "Dockerfile",
  "preDeployCommand": [
    "python manage.py migrate --noinput"
  ],
  "healthcheckPath": "/health/",
  "healthcheckTimeout": 120,
  "restartPolicyType": "ON_FAILURE",
  "restartPolicyMaxRetries": 3,
  "sleepApplication": false,
  "watchPatterns": [
    "/.dockerignore",
    "/Dockerfile",
    "/requirements.txt",
    "/manage.py",
    "/config/**",
    "/monitoring/**"
  ],
  "railwayConfigFile": null
}

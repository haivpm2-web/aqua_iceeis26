# Reference template. Django reads process environment variables; it does not
# automatically load this file or .env. See README.md for PowerShell startup.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SOFTWARE_VERSION=development
SENSOR_OFFLINE_SECONDS=30
ANALYSIS_MAX_SAMPLES=200000
# Optional for local staff-session authentication; required for gateway Bearer writes.
# INGEST_API_TOKEN=generate-a-random-token
# SECRET_KEY=generate-a-random-secret-of-at-least-50-characters

# Railway production: configure these in the web service Variables tab.
# Replace the example hostname and secret values before use.
# DEBUG=false
# SECRET_KEY=generate-a-random-secret-of-at-least-50-characters
# INGEST_API_TOKEN=generate-a-different-random-token
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# ALLOWED_HOSTS=your-service.up.railway.app,healthcheck.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app
# SECURE_SSL_REDIRECT=true
# SOFTWARE_VERSION=${{RAILWAY_GIT_COMMIT_SHA}}
